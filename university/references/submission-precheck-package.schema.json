{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission-precheck-package.schema.json",
  "title": "Gaokao Submission Precheck Package",
  "type": "object",
  "required": [
    "province",
    "year",
    "candidate_profile",
    "candidate_rank_evidence",
    "provincial_policy_evidence",
    "plan_corrections_evidence",
    "candidate_items"
  ],
  "additionalProperties": false,
  "properties": {
    "province": { "type": "string", "minLength": 1 },
    "year": { "type": "integer", "const": 2026 },
    "candidate_profile": { "$ref": "candidate-profile.schema.json" },
    "candidate_rank_evidence": { "$ref": "#/$defs/rank_evidence" },
    "provincial_policy_evidence": { "$ref": "#/$defs/official_evidence" },
    "plan_corrections_evidence": {
      "allOf": [
        { "$ref": "#/$defs/official_evidence" },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["checked", "corrected", "none_found_current", "monitor_current"]
            }
          }
        }
      ]
    },
    "candidate_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate_item" }
    }
  },
  "$defs": {
    "official_evidence": {
      "type": "object",
      "required": [
        "source_title",
        "source_url",
        "applicable_year",
        "field_evidence_level",
        "retrieved_at"
      ],
      "additionalProperties": true,
      "properties": {
        "source_title": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "applicable_year": { "type": "integer", "const": 2026 },
        "field_evidence_level": { "type": "string", "const": "official_current" },
        "retrieved_at": { "type": "string", "format": "date" }
      }
    },
    "rank_evidence": {
      "type": "object",
      "required": [
        "rank",
        "rank_basis",
        "source_title",
        "source_url",
        "applicable_year",
        "field_evidence_level",
        "sensitive_info_redacted",
        "retrieved_at"
      ],
      "additionalProperties": true,
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "rank_basis": {
          "type": "string",
          "enum": ["official_score_query", "one_score_one_rank", "official_user_export"]
        },
        "source_title": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "applicable_year": { "type": "integer", "const": 2026 },
        "field_evidence_level": {
          "type": "string",
          "enum": ["official_current", "user_supplied"]
        },
        "sensitive_info_redacted": { "type": "boolean", "const": true },
        "retrieved_at": { "type": "string", "format": "date" }
      }
    },
    "candidate_item": {
      "type": "object",
      "required": [
        "candidate_item_id",
        "plan_item",
        "subject_qualification",
        "charter_restrictions"
      ],
      "additionalProperties": true,
      "properties": {
        "candidate_item_id": { "type": "string", "minLength": 1 },
        "plan_item": { "$ref": "enrollment-plan-item.schema.json" },
        "subject_qualification": { "$ref": "#/$defs/subject_qualification" },
        "charter_restrictions": { "$ref": "#/$defs/charter_restrictions" }
      }
    },
    "subject_qualification": {
      "type": "object",
      "required": [
        "status",
        "source_title",
        "source_url",
        "applicable_year",
        "field_evidence_level",
        "matched_requirements",
        "retrieved_at"
      ],
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "const": "pass" },
        "source_title": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "applicable_year": { "type": "integer", "const": 2026 },
        "field_evidence_level": { "type": "string", "const": "official_current" },
        "matched_requirements": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "proof_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "retrieved_at": { "type": "string", "format": "date" }
      }
    },
    "charter_restrictions": {
      "type": "object",
      "required": [
        "status",
        "institution_code",
        "source_title",
        "source_url",
        "applicable_year",
        "field_evidence_level",
        "retrieved_at",
        "rules"
      ],
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "const": "pass" },
        "institution_code": { "type": "string", "minLength": 1 },
        "source_title": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "applicable_year": { "type": "integer", "const": 2026 },
        "field_evidence_level": { "type": "string", "const": "official_current" },
        "retrieved_at": { "type": "string", "format": "date" },
        "rules": {
          "type": "object",
          "required": [
            "physical_exam",
            "single_subject",
            "foreign_language",
            "filing_ratio",
            "major_admission",
            "adjustment_rule"
          ],
          "properties": {
            "physical_exam": { "type": "string", "minLength": 1 },
            "single_subject": { "type": "string", "minLength": 1 },
            "foreign_language": { "type": "string", "minLength": 1 },
            "filing_ratio": { "type": "string", "minLength": 1 },
            "major_admission": { "type": "string", "minLength": 1 },
            "adjustment_rule": { "type": "string", "minLength": 1 }
          }
        },
        "proof_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}
